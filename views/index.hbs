<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />

  </head>
  <body>

    <!-- Render your specific HBS view body here -->
    <div class="container mt-4">
      <button type="button" class="btn btn-btn btn-success">
        Add New User
      </button>
      <table class="table table-striped table-dark">
        <thead>
          <tr>
            <th scope="col">Id</th>
            <th scope="col">User Name</th>
            <th scope="col">Email</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          {{#each items}}
            <tr>
              <td>{{this._id}} </td>
              <td>{{this.username}} </td>
              <td>{{this.email}} </td>
              <td>
                <button
                  type="button"
                  class="btn btn-danger"
                  onclick="showID({{this._id}})"
                >

                  Delete
                </button>

              </td>
            </tr>
          {{else}}
            <tr>
              <td>No items found in the database.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>

    </div>
    <!-- Bootstrap Bundle with Popper -->
    <script src="/js/bootstrap.bundle.min.js">
      function showID(id) { alert(id); }
    </script>
  </body>
</html>